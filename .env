AI_APP_NAME=SPM IA Agent API
AI_APP_VERSION=4.1.2-precise-fast
AI_HOST=0.0.0.0
AI_PORT=8080
AI_ENABLE_DOCS=true

# Front local. Agrega otro origen sÃ³lo si realmente lo necesitas.
AI_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202,http://localhost:3650,http://127.0.0.1:4200,http://127.0.0.1:4202,http://127.0.0.1:3650
AI_ALLOWED_HOSTS=localhost,127.0.0.1,profile-intelligence-api

AI_LLM_ENABLED=true
AI_LLM_BASE_URL=http://ollama:11434
AI_LLM_ALLOWED_HOSTS=ollama,localhost,127.0.0.1
AI_LLM_MODEL=qwen3:4b
AI_LLM_TEMPERATURE=0.10
AI_LLM_NUM_CTX=4096
AI_LLM_MAX_PREDICT=500
AI_LLM_TIMEOUT_SECONDS=180
AI_LLM_HISTORY_MESSAGES=2
AI_LLM_MAX_EVIDENCE=30

AI_CONTEXT_MAX_CHARS=6000
AI_MAX_CONTENT_LENGTH=5242880
AI_MAX_CASE_BYTES=1073741824
AI_DEEP_BATCH_CHARS=42000
AI_DEEP_MAX_CHUNKS=5000
AI_CASE_DATA_DIR=/data/cases

API_PORT=3651
OLLAMA_PORT=11434
OLLAMA_IMAGE=ollama/ollama:latest

# Estas variables sÃ³lo existen para compatibilidad con compose antiguos.
AI_IMAGE=spm-profile-intelligence-api
AI_VERSION=4.1.2-precise-fast
AI_BIND_IP=127.0.0.1



AI_LLM_MODEL_FAST=qwen3:1.7b
AI_LLM_MODEL_DEEP=qwen3:4b
AI_LLM_THINKING_DEFAULT=false
AI_LLM_THINKING_MAX_PREDICT=1200
AI_FORCE_SPANISH_THINKING=false
AI_CONTEXT_DEEP_MAX_CHARS=12000
AI_LLM_NUM_THREAD=
AI_LLM_WARMUP=true
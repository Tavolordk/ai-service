AI_APP_NAME=SPM IA Agent API
AI_APP_VERSION=4.0.4-reasoning-recovery
AI_HOST=0.0.0.0
AI_PORT=8080
AI_ENABLE_DOCS=true

AI_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202,http://localhost:3650,http://127.0.0.1:4200,http://127.0.0.1:4202,http://127.0.0.1:3650
AI_ALLOWED_HOSTS=localhost,127.0.0.1,profile-intelligence-api

AI_LLM_ENABLED=true
AI_LLM_BASE_URL=http://ollama:11434

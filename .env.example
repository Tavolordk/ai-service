AI_LLM_MODEL=qwen3:4b
AI_LLM_TEMPERATURE=0.10
AI_LLM_NUM_CTX=12288
AI_LLM_MAX_PREDICT=2400
AI_LLM_TIMEOUT_SECONDS=1200
AI_LLM_CONNECT_TIMEOUT_SECONDS=30
AI_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=1200
AI_LLM_STREAM_IDLE_TIMEOUT_SECONDS=600
AI_LLM_FINAL_TIMEOUT_SECONDS=1800
AI_LLM_HISTORY_MESSAGES=6
AI_LLM_MAX_EVIDENCE=72
AI_LLM_KEEP_ALIVE=30m

AI_CONTEXT_MAX_CHARS=14000
AI_CONTEXT_DEEP_MAX_CHARS=28000
AI_CONTEXT_MAX_FACTS_PER_SECTION=28
AI_CONTEXT_CACHE_ENTRIES=128
AI_CONTEXT_CACHE_TTL_SECONDS=3600
AI_MAX_CONTENT_LENGTH=5242880
AI_MAX_CASE_BYTES=1073741824
AI_DEEP_BATCH_CHARS=42000
AI_DEEP_MAX_CHUNKS=5000
AI_CASE_DATA_DIR=/data/cases

API_PORT=3651
OLLAMA_PORT=11434
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=30m

AI_IMAGE=spm-profile-intelligence-api
AI_VERSION=4.0.4-reasoning-recovery
AI_BIND_IP=127.0.0.1

AI_FAST_PATH_ENABLED=true

AI_APP_NAME=SPM IA Agent API
AI_APP_VERSION=4.0.0-hybrid-router
AI_HOST=0.0.0.0
AI_PORT=8080
AI_ENABLE_DOCS=true

# Front local. Agrega otro origen sólo si realmente lo necesitas.
AI_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4202,http://localhost:3650,http://127.0.0.1:4200,http://127.0.0.1:4202,http://127.0.0.1:3650
AI_ALLOWED_HOSTS=localhost,127.0.0.1,profile-intelligence-api

AI_LLM_ENABLED=true
AI_LLM_BASE_URL=http://ollama:11434
AI_LLM_ALLOWED_HOSTS=ollama,localhost,127.0.0.1
AI_LLM_MODEL=qwen3:4b
AI_LLM_TEMPERATURE=0.10
AI_LLM_NUM_CTX=12288
AI_LLM_MAX_PREDICT=2400
# Compatibilidad con versiones anteriores.
AI_LLM_TIMEOUT_SECONDS=1200
# Tiempo máximo para establecer la conexión TCP/HTTP.
AI_LLM_CONNECT_TIMEOUT_SECONDS=30
# En CPU, Qwen puede tardar varios minutos en procesar perfiles grandes antes del primer token.
AI_LLM_FIRST_TOKEN_TIMEOUT_SECONDS=1200
# Una vez que comenzó el streaming, máximo tiempo sin recibir un fragmento nuevo.
AI_LLM_STREAM_IDLE_TIMEOUT_SECONDS=600
# Generaciones no-stream usadas para reconstruir/validar la respuesta final.
AI_LLM_FINAL_TIMEOUT_SECONDS=1800
AI_LLM_HISTORY_MESSAGES=6
AI_LLM_MAX_EVIDENCE=72
AI_LLM_KEEP_ALIVE=30m

# Contexto compacto y cacheado para equipos con pocos recursos.
AI_CONTEXT_MAX_CHARS=14000
AI_CONTEXT_DEEP_MAX_CHARS=28000
AI_CONTEXT_MAX_FACTS_PER_SECTION=28
AI_CONTEXT_CACHE_ENTRIES=128
AI_CONTEXT_CACHE_TTL_SECONDS=3600
AI_MAX_CONTENT_LENGTH=5242880
AI_MAX_CASE_BYTES=1073741824
AI_DEEP_BATCH_CHARS=42000
AI_DEEP_MAX_CHUNKS=5000
AI_CASE_DATA_DIR=/data/cases

API_PORT=3651
OLLAMA_PORT=11434
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_KEEP_ALIVE=30m

# Estas variables sólo existen para compatibilidad con compose antiguos.
AI_IMAGE=spm-profile-intelligence-api
AI_VERSION=4.0.0-hybrid-router
AI_BIND_IP=127.0.0.1

# Fast path determinista: preguntas sencillas no llaman a Qwen
AI_FAST_PATH_ENABLED=true
AI_FAST_SUMMARY_ENABLED=true
AI_FAST_MAX_LIST_ITEMS=12
